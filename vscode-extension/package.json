{
  "name": "deepseek-codex-launcher",
  "displayName": "DeepSeek Codex Isolated Launcher",
  "description": "Launch an isolated VS Code window whose Codex uses DeepSeek V4 Flash or Pro.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:deepseekCodex.launchFlash",
    "onCommand:deepseekCodex.launchPro",
    "onCommand:deepseekCodex.pickAndLaunch"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseekCodex.pickAndLaunch",
        "title": "DeepSeek Codex: Open Isolated Window"
      },
      {
        "command": "deepseekCodex.launchFlash",
        "title": "DeepSeek Codex: Open Isolated Flash"
      },
      {
        "command": "deepseekCodex.launchPro",
        "title": "DeepSeek Codex: Open Isolated Pro"
      }
    ],
    "configuration": {
      "title": "DeepSeek Codex Launcher",
      "properties": {
        "deepseekCodexLauncher.root": {
          "type": "string",
          "default": "",
          "description": "Folder containing scripts/start-deepseek-vscode.ps1."
        },
        "deepseekCodexLauncher.deepSeekProxyUrl": {
          "type": "string",
          "default": "",
          "description": "Optional HTTP/HTTPS proxy URL used only by the local ds-codex proxy when calling api.deepseek.com."
        }
      }
    }
  }
}
